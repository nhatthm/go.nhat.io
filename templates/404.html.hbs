<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ pageDescription }}">
<title>{{ pageTitle }}</title>
<link rel="shortcut icon" type="image/x-icon" href="https://go.dev/favicon.ico" />
<link rel="preload" as="font" type="font/woff2" href="https://nhat.me/fonts/outfit.woff2?v=1" crossorigin>
<link rel="stylesheet" href="https://nhat.me/css/style.min.css?v=2">
</head>
<body>
<div class="page">
<a class="coffee-rail" href="https://donate.nhat.me">
  <img src="https://nhat.me/images/coffee-mug.svg" width="18" height="18" alt="">
  <span style="writing-mode:vertical-rl">Buy me a coffee</span>
</a>

<nav>
  <a href="https://nhat.me">About me</a>
  <a href="https://{{ host }}" class="nav-active">Go registry</a>
  <a href="https://fonts.nhat.io">Ligaturized fonts</a>
</nav>

<div class="split">
  <img class="gopher" src="https://raw.githubusercontent.com/nhatthm/govanityrender/master/resources/assets/404.svg" alt="A Go gopher, lost" style="width:100%; height:auto">
  <div class="split-copy">
    <h1 class="split-title">404</h1>
    <div class="code-box">
      <code>panic("DO NOT PANIC")</code>
    </div>
    <p class="split-p">What you're looking for may have been OOM killed.
      {{#if sourceURL}}
      Do you want to see <a class="mark-link" href="https://{{ host }}">all the cool modules</a>?
      {{/if}}
    </p>
    <a class="btn-outline accent coffee-inline" href="https://donate.nhat.me">Buy me a coffee</a>
  </div>
</div>

<div class="render-footer">
  <span>Generated by <a class="mark-link on-mute" href="https://github.com/nhatthm/govanityrender" target="_blank" rel="noopener noreferrer" style="color:var(--mute)">vanityrender</a> {{ renderer.version }}</span>
</div>
</div>
</body>
</html>
