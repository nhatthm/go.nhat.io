<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ pageDescription }}">
<title>{{ pageTitle }}</title>
<link rel="shortcut icon" type="image/x-icon" href="https://go.dev/favicon.ico" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap">
<style>
:root {
  --bg: #FAF9F5; --ink: #14162B; --body: #4C4F66; --mute: #63667F;
  --line: #E1E1EC; --btn: #2547E8; --btn-ink: #FFFFFF; --accent: #2547E8;
  --card: #FFFFFF; --code: #14162B; --code-ink: #EEEEF6; --hover: rgba(37,71,232,.045);
  --warn: #B4361D; --warn-line: rgba(180,54,29,.30);
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #121218; --ink: #EEEEF6; --body: #A2A5BC; --mute: #8A8DA6;
    --line: #22243A; --btn: #8AA8FF; --btn-ink: #0E0F1A; --accent: #8AA8FF;
    --card: #14162B; --code: #191B2E; --code-ink: #EEEEF6; --hover: rgba(138,168,255,.07);
    --warn: #FF9E86; --warn-line: rgba(255,158,134,.32);
  }
}
* { box-sizing: border-box; }
html, body { overflow-x: hidden; }
body { margin: 0; background: var(--bg); font-family: 'Outfit', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
a { color: var(--ink); text-decoration: none; }
a:hover { opacity: .7; }
.mark-link { text-decoration: none; padding-bottom: 1px; border-bottom: 1px solid var(--line); transition: border-bottom-width .2s cubic-bezier(.4,0,.2,1), border-color .2s cubic-bezier(.4,0,.2,1); }
.mark-link:hover { opacity: 1; color: var(--mute); border-bottom: 2px solid var(--mute); }
input { font-family: inherit; }
input::placeholder { color: var(--mute); opacity: 1; }
button { font-family: inherit; cursor: pointer; }
.coffee-rail { display: flex; }
.coffee-inline { display: none; }
.wrap { width: 100%; max-width: 720px; margin: 0 auto; padding: 56px 0 80px; display: flex; flex-direction: column; }
.usage-bar { display: flex; align-items: center; gap: 12px; background: var(--code); border-radius: 16px; padding: 18px 20px; }
.usage-code { flex: 1; min-width: 0; overflow-x: auto; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14.5px; line-height: 1.5; color: var(--code-ink); white-space: nowrap; }
.usage-copy { flex: none; border: 1px solid rgba(255,255,255,.18); background: transparent; color: var(--code-ink); font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 8px 14px; border-radius: 999px; transition: opacity .2s cubic-bezier(.4,0,.2,1); }
.usage-copy:hover { opacity: .65; }
.list-head { margin-top: 34px; display: flex; align-items: baseline; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
.list-count { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute); }
.list-filter { flex: 0 1 240px; background: transparent; border: none; border-bottom: 1px solid var(--line); color: var(--ink); font-size: 15px; font-weight: 400; padding: 6px 2px; outline: none; transition: border-color .2s cubic-bezier(.4,0,.2,1); }
.list-filter:focus { border-bottom-color: var(--accent); }
.list { display: flex; flex-direction: column; }
.row { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 24px; padding: 13px 12px; margin: 0 -12px; border-bottom: 1px solid var(--line); border-radius: 12px; transition: background-color .2s cubic-bezier(.4,0,.2,1); }
.row:hover { background: var(--hover); }
.row-main { min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.row-title { display: flex; align-items: center; gap: 8px; min-width: 0; }
.row-name { font-size: 16.5px; font-weight: 500; line-height: 1.35; letter-spacing: -0.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.row-badge { flex: none; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--warn); border: 1px solid var(--warn-line); padding: 2px 8px; border-radius: 999px; }
.row-path { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; color: var(--mute); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.row-deprecated { font-size: 13px; font-weight: 400; line-height: 1.5; color: var(--warn); }
.row-deprecated code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
.row-end { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }
.row-copy { border: 1px solid var(--line); background: transparent; color: var(--mute); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; font-weight: 500; padding: 6px 12px; border-radius: 999px; transition: color .2s cubic-bezier(.4,0,.2,1), border-color .2s cubic-bezier(.4,0,.2,1); }
.row-copy:hover { color: var(--accent); border-color: var(--accent); }
.row-repo { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 999px; border: 1px solid var(--line); color: var(--mute); }
.row-repo:hover { color: var(--accent); border-color: var(--accent); opacity: 1; }
.empty { margin: 34px 0 0; text-align: center; font-size: 16px; font-weight: 300; color: var(--mute); display: none; }
.contribute { margin-top: 56px; display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
.contribute-label { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute); }
.contribute-copy { margin: 0; max-width: 44ch; font-size: 17px; font-weight: 300; line-height: 1.7; color: var(--body); }
.contribute-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; padding-top: 4px; }
.btn-solid { padding: 12px 24px; border-radius: 999px; background: var(--btn); color: var(--btn-ink); font-size: 15px; font-weight: 500; }
.btn-outline { padding: 12px 24px; border-radius: 999px; border: 1px solid var(--line); font-size: 15px; font-weight: 500; }
.btn-outline.accent { color: var(--accent); }
.render-footer { margin-top: 26px; font-size: 13.5px; font-weight: 300; color: var(--mute); }
@media (max-width: 900px) { .coffee-rail { display: none; } .coffee-inline { display: inline-flex; } }
@media (max-width: 640px) { .row { grid-template-columns: 1fr !important; gap: 6px !important; } .row-end { justify-content: flex-start !important; } }
</style>
</head>
<body>
<div style="background:var(--bg); color:var(--ink); min-height:100vh; padding:0 28px">
<a class="coffee-rail" href="https://donate.nhat.me" target="_blank" rel="noopener noreferrer" style="position:fixed; right:20px; top:50%; transform:translateY(-50%); z-index:30; flex-direction:column; align-items:center; gap:8px; padding:16px 12px; border-radius:999px; background:var(--bg); border:1px solid var(--line); box-shadow:0 6px 20px rgba(20,22,43,.10); font-size:12px; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--accent)">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8Z"></path><path d="M17 9h1.6a2.4 2.4 0 0 1 0 4.8H17"></path><path d="M7 4.5c0 .8.8 1 .8 1.8"></path><path d="M11 4c0 .9.9 1.2.9 2.1"></path></svg>
  <span style="writing-mode:vertical-rl">Buy me a coffee</span>
</a>

<nav style="max-width:720px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; gap:20px; padding:24px 0; border-bottom:1px solid var(--line); font-size:15px; font-weight:500">
  <a href="https://nhat.me">About me</a>
  <a href="https://{{ host }}" style="color:var(--accent)">Go registry</a>
  <a href="https://fonts.nhat.io">Ligaturized fonts</a>
</nav>

<div class="wrap">
  <div class="usage-bar">
    <code id="usage-code" class="usage-code"><span style="opacity:.5">$</span> go get -u {{ host }}/&lt;MODULE&gt;</code>
    <button type="button" id="usage-copy" class="usage-copy" data-copy-text="go get -u {{ host }}/&lt;MODULE&gt;">Copy</button>
  </div>

  <div class="list-head">
    <span id="list-count" class="list-count"></span>
    <input id="list-filter" class="list-filter" type="text" placeholder="Filter modules" autocomplete="off">
  </div>

  <div id="list" class="list">
    {{#each repositories}}
    {{#unless hidden}}
    <div class="row" data-search="{{ name }} {{ path }}">
      <div class="row-main">
        <div class="row-title">
          <a class="row-name" href="https://pkg.go.dev/{{ host }}/{{ path }}" target="_blank" rel="noopener noreferrer">{{ name }}</a>
          {{#if deprecated}}
          <span class="row-badge">Deprecated</span>
          {{/if}}
        </div>
        <span class="row-path">{{ host }}/{{ path }}</span>
        {{#if deprecated}}
        <span class="row-deprecated">{{ deprecated }}</span>
        {{/if}}
      </div>
      <div class="row-end">
        <button type="button" class="row-copy" title="Copy go get command" data-copy-text="go get -u {{ host }}/{{ path }}@{{ latestVersion }}">{{ latestVersion }}</button>
        <a class="row-repo" href="{{ repositoryURL }}" target="_blank" rel="noopener noreferrer" title="Source repository">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"></path><path d="M8.5 7H17v8.5"></path></svg>
        </a>
      </div>
    </div>
    {{/unless}}
    {{/each}}
  </div>

  <p id="list-empty" class="empty">No module matches that filter.</p>

  <div class="contribute">
    <span class="contribute-label">Contribute</span>
    <p class="contribute-copy">Issues and pull requests are welcome on any of the repositories. The registry itself is generated from a single manifest.</p>
    <div class="contribute-actions">
      {{#if sourceURL}}
      <a class="btn-solid" href="{{ sourceURL }}" target="_blank" rel="noopener noreferrer">Registry source</a>
      {{/if}}
      <a class="btn-outline" href="https://github.com/nhatthm" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="btn-outline accent coffee-inline" href="https://donate.nhat.me" target="_blank" rel="noopener noreferrer">Buy me a coffee</a>
    </div>
    <span class="render-footer">Generated by <a class="mark-link" href="https://github.com/nhatthm/govanityrender" target="_blank" rel="noopener noreferrer" style="color:var(--mute)">vanityrender</a> {{ renderer.version }}</span>
  </div>
</div>
</div>

<script>
(function () {
  function copy(text, btn, doneLabel) {
    var original = btn.textContent;

    function done() {
      btn.textContent = doneLabel || 'Copied';
      setTimeout(function () { btn.textContent = original; }, 1600);
    }

    function fallback() {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0;pointer-events:none';
      document.body.appendChild(ta);
      ta.select();
      ta.setSelectionRange(0, text.length);
      try { document.execCommand('copy'); } catch (e) {}
      document.body.removeChild(ta);
      done();
    }

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done, fallback);
    } else {
      fallback();
    }
  }

  document.body.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-copy-text]');
    if (!btn) return;
    copy(btn.getAttribute('data-copy-text').replace(/&lt;/g, '<').replace(/&gt;/g, '>'), btn, btn.id === 'usage-copy' ? 'Copied' : 'copied');
  });

  var rows = Array.prototype.slice.call(document.querySelectorAll('#list .row'));
  var countEl = document.getElementById('list-count');
  var emptyEl = document.getElementById('list-empty');
  var filterEl = document.getElementById('list-filter');

  function applyFilter() {
    var q = filterEl.value.trim().toLowerCase();
    var visible = 0;

    rows.forEach(function (row) {
      var match = !q || row.getAttribute('data-search').toLowerCase().indexOf(q) !== -1;
      row.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    countEl.textContent = q ? (visible + ' of ' + rows.length + ' modules') : (rows.length + ' modules');
    emptyEl.style.display = visible === 0 ? '' : 'none';
  }

  filterEl.addEventListener('input', applyFilter);
  applyFilter();
})();
</script>
</body>
</html>
