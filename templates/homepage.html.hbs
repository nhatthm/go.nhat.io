<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ pageDescription }}">
<title>{{ pageTitle }}</title>
<link rel="shortcut icon" type="image/x-icon" href="https://go.dev/favicon.ico" />
<link rel="preload" as="font" type="font/woff2" href="https://nhat.me/fonts/outfit.woff2?v=1" crossorigin>
<link rel="stylesheet" href="https://nhat.me/css/style.min.css?v=2">
</head>
<body>
<div class="page">
<a class="coffee-rail" href="https://donate.nhat.me">
  <img src="https://nhat.me/images/coffee-mug.svg" width="18" height="18" alt="">
  <span style="writing-mode:vertical-rl">Buy me a coffee</span>
</a>

<nav>
  <a href="https://nhat.me">About me</a>
  <a href="https://{{ host }}" class="nav-active">Go registry</a>
  <a href="https://fonts.nhat.io">Ligaturized fonts</a>
</nav>

<div class="wrap">
  <div class="usage-bar">
    <code id="usage-code" class="usage-code"><span style="opacity:.5">$</span> go get -u {{ host }}/&lt;MODULE&gt;</code>
    <button type="button" id="usage-copy" class="usage-copy" data-copy-text="go get -u {{ host }}/&lt;MODULE&gt;">Copy</button>
  </div>
  <span class="code-note">Replace &lt;MODULE&gt; with the module name below, or click a version button to copy the exact install command.</span>

  <div class="list-head">
    <span id="list-count" class="list-count"></span>
    <input id="list-filter" class="list-filter" type="text" placeholder="Filter modules" autocomplete="off">
  </div>

  <div id="list" class="list">
    {{#each repositories}}
    {{#unless hidden}}
    <div class="row" data-search="{{ name }} {{ path }}">
      <div class="row-main">
        <div class="row-title">
          <a class="row-name" href="https://pkg.go.dev/{{ host }}/{{ path }}" target="_blank" rel="noopener noreferrer">{{ name }}</a>
          {{#if deprecated}}
          <span class="row-badge">Deprecated</span>
          {{/if}}
        </div>
        <span class="row-path">{{ host }}/{{ path }}</span>
        {{#if deprecated}}
        <span class="row-deprecated">{{ deprecated }}</span>
        {{/if}}
      </div>
      <div class="row-end">
        <button type="button" class="row-copy" title="Copy go get command" data-copy-text="go get -u {{ host }}/{{ path }}@{{ latestVersion }}">{{ latestVersion }}</button>
        <a class="row-repo" href="{{ repositoryURL }}" target="_blank" rel="noopener noreferrer" title="Source repository">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"></path><path d="M8.5 7H17v8.5"></path></svg>
        </a>
      </div>
    </div>
    {{/unless}}
    {{/each}}
  </div>

  <p id="list-empty" class="empty">No module matches that filter.</p>

  <div class="contribute">
    <span class="contribute-label">Contribute</span>
    <p class="contribute-copy">Issues and pull requests are welcome on any of the repositories. The registry itself is generated from a single manifest.</p>
    <div class="contribute-actions">
      {{#if sourceURL}}
      <a class="btn-solid" href="{{ sourceURL }}" target="_blank" rel="noopener noreferrer">Registry source</a>
      {{/if}}
      <a class="btn-outline" href="https://github.com/nhatthm" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="btn-outline accent coffee-inline" href="https://donate.nhat.me">Buy me a coffee</a>
    </div>
    <span class="render-footer">Generated by <a class="mark-link" href="https://github.com/nhatthm/govanityrender" target="_blank" rel="noopener noreferrer" style="color:var(--mute)">vanityrender</a> {{ renderer.version }}</span>
  </div>
</div>
</div>

<script>
(function () {
  function copy(text, btn, doneLabel) {
    var original = btn.textContent;

    function done() {
      btn.textContent = doneLabel || 'Copied';
      setTimeout(function () { btn.textContent = original; }, 1600);
    }

    function fallback() {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0;pointer-events:none';
      document.body.appendChild(ta);
      ta.select();
      ta.setSelectionRange(0, text.length);
      try { document.execCommand('copy'); } catch (e) {}
      document.body.removeChild(ta);
      done();
    }

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done, fallback);
    } else {
      fallback();
    }
  }

  document.body.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-copy-text]');
    if (!btn) return;
    copy(btn.getAttribute('data-copy-text').replace(/&lt;/g, '<').replace(/&gt;/g, '>'), btn, btn.id === 'usage-copy' ? 'Copied' : 'copied');
  });

  var rows = Array.prototype.slice.call(document.querySelectorAll('#list .row'));
  var countEl = document.getElementById('list-count');
  var emptyEl = document.getElementById('list-empty');
  var filterEl = document.getElementById('list-filter');

  function applyFilter() {
    var q = filterEl.value.trim().toLowerCase();
    var visible = 0;

    rows.forEach(function (row) {
      var match = !q || row.getAttribute('data-search').toLowerCase().indexOf(q) !== -1;
      row.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    countEl.textContent = q ? (visible + ' of ' + rows.length + ' modules') : (rows.length + ' modules');
    emptyEl.style.display = visible === 0 ? '' : 'none';
  }

  filterEl.addEventListener('input', applyFilter);
  applyFilter();
})();
</script>
</body>
</html>
